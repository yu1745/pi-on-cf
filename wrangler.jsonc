/**
 * Pi on Cloudflare — Free-plan slim config.
 *
 * Removed for Free plan compatibility:
 *   - containers          (requires Workers Paid)
 *   - worker_loaders      (Dynamic Workers, requires Workers Paid)
 *   - artifacts           (APP_ARTIFACTS)
 *   - compatibility flag  ("experimental", needed by worker_loaders)
 *   - AI Gateway          (direct to LLM provider instead)
 *
 * LLM: MiniMax-M3 via OpenAI-compatible endpoint (direct, no AI Gateway).
 * Git: isomorphic-git via @cloudflare/computer/git (no backend required).
 *
 * 前端: 纯 SPA（无 SSR）。前端构建产物（dist/client）作为 Workers Static
 * Assets 部署，不计入 Worker 3MB bundle 上限。Worker 仅处理 /api/* 请求。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-on-cf",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "directory": "./dist/client/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AI_BASE_URL": "https://api.deepseek.com",
    "AI_MODEL": "deepseek-v4-flash",
    "AI_MEMORY_MODEL": "deepseek-v4-flash",
    "COMPUTER_R2_BUCKET": "pi-on-cf-computer",
    "SEARCH_BACKEND": "",
    "SEARCH_API_URL": "",
    "SEARCH_API_KEY": ""
  },
  "secrets": {
    "required": [
      "CLOUDFLARE_ACCOUNT_ID",
      "AI_API_KEY",
      "CF_API_TOKEN",
      "GIT_TOKEN"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PiSession",
        "class_name": "PiSession"
      },
      {
        "name": "PiRegistry",
        "class_name": "PiRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiSession"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PiRegistry"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "COMPUTER_R2",
      "bucket_name": "pi-on-cf-computer"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "upload_source_maps": true
}
